{
  "info": {
    "name": "UA Clinic",
    "_postman_id": "ua-clinic-collection",
    "description": "Postman collection for UA Clinic backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Test Student\", \"email\": \"student@ua.edu.ph\", \"password\": \"pass123\", \"role\": \"student\"}"
        }
      }
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"student@ua.edu.ph\", \"password\": \"pass123\"}"
        }
      }
    },
    {
      "name": "Patients - Create",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/patients",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "patients"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"schoolId\": \"2025-0001\", \"fullName\": \"Juan Dela Cruz\", \"sex\": \"Male\", \"birthDate\": \"2004-01-15\", \"contactNumber\": \"09171234567\", \"address\": \"San Fernando, Pampanga\", \"allergies\": [\"Peanuts\"], \"bloodType\": \"O+\"}"
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "token",
      "value": ""
    }
  ]
}